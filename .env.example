# Copy to .env for local use, or set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values and never paste them into chats.

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret. Server-side only (Vercel env var). Never in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (https://aistudio.google.com/apikey) - optional ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email via Resend (https://resend.com) - optional ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. "KirayaKhata <invoices@yourdomain.in>"
EMAIL_FROM=

PORT=4173
